# Normalize text in Git and let local Git settings determine checkout line endings.
* text=auto

# Shell scripts and repository-managed hooks must work on Unix-like systems.
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf
/.githooks/** text=auto eol=lf

# Do not apply any line-ending conversion to icons.
*.ico binary
