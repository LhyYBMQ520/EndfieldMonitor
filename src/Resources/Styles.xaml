<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- 与参考页一致的配色 -->
    <Color x:Key="PaperColor">#EEEEEB</Color>
    <Color x:Key="InkColor">#292929</Color>
    <Color x:Key="YellowColor">#FFF000</Color>

    <SolidColorBrush x:Key="PaperBrush" Color="#EEEEEB" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#BCBCB8" />
    <SolidColorBrush x:Key="InkBrush" Color="#292929" />
    <SolidColorBrush x:Key="SubtleInkBrush" Color="#74746F" />
    <SolidColorBrush x:Key="YellowBrush" Color="#FFF000" />
    <SolidColorBrush x:Key="CapsuleBrush" Color="#242424" />
    <SolidColorBrush x:Key="CapsuleHoverBrush" Color="#101010" />
    <SolidColorBrush x:Key="CapsulePressedBrush" Color="#080808" />
    <SolidColorBrush x:Key="DotPillBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="FieldBrush" Color="#F7F7F4" />
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#C4C4BF" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#E1E1DB" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#D6D6CD" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9A5B00" />

    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Microsoft YaHei, Arial</FontFamily>
    <FontFamily x:Key="DigitFont">Arial, Microsoft YaHei</FontFamily>

    <!-- 键盘焦点：与参考页 outline 2px #555 一致 -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="#555555" StrokeThickness="1.5" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 右上角悬浮关闭按钮 -->
    <Style x:Key="CloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Disc" CornerRadius="12" Background="#E6242424" BorderBrush="#66FFFFFF" BorderThickness="0.75" Margin="2" />
                        <Path x:Name="Glyph" Data="M0,0 L7,7 M7,0 L0,7" Stroke="#E6E6E2" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Background" Value="#FF101010" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource YellowBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Disc" Property="Background" Value="#FF000000" />
                            <Setter TargetName="Disc" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX=".92" ScaleY=".92" CenterX="10" CenterY="10" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- “电能报告”胶囊（真正的 Button），右侧三点为胶囊的一部分 -->
    <Style x:Key="ReportCapsuleStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Capsule" CornerRadius="17.5" Background="{StaticResource CapsuleBrush}"
                            RenderTransformOrigin="0.5,0.5">
                        <Grid Margin="18,0,10,0">
                            <TextBlock Text="电能报告" Foreground="White" FontSize="28" FontFamily="{StaticResource UiFont}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,-2,0,0" />
                            <!-- .more：宽 21%（35.7）、高 61%（21.4）；内部 svg 62%×60%，viewBox 24×12 -->
                            <Border Width="35.7" Height="21.4" CornerRadius="10.7" Background="{StaticResource DotPillBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Viewbox Width="22.1" Height="12.8" Stretch="Uniform">
                                    <Canvas Width="24" Height="12">
                                        <Path Data="M3,6 H5 M11,6 H13 M19,6 H21" Stroke="#8B8B8B" StrokeThickness="3" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Capsule" Property="Background" Value="{StaticResource CapsuleHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Capsule" Property="Background" Value="{StaticResource CapsulePressedBrush}" />
                            <Setter TargetName="Capsule" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX=".97" ScaleY=".97" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Tag" Value="Open">
                            <Setter TargetName="Capsule" Property="Background" Value="{StaticResource CapsulePressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 设置面板控件 -->
    <Style x:Key="PanelButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
        <Setter Property="Foreground" Value="#333333" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#CBCBC1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#9A9A95" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelIconButton" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Foreground" Value="#444444" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#DDDDD6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource FieldBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
        <Setter Property="Foreground" Value="#2A2A2A" />
        <Setter Property="Padding" Value="5,4" />
        <Setter Property="CaretBrush" Value="#2A2A2A" />
        <Setter Property="SelectionBrush" Value="#B8B000" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="#555555" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PanelCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#333333" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" />
                        <Border x:Name="Track" Grid.Column="1" Width="34" Height="16" CornerRadius="8" Background="#CFCFC8" Margin="8,0,0,0">
                            <Border x:Name="Knob" Width="12" Height="12" CornerRadius="6" Background="White" HorizontalAlignment="Left" Margin="2,0" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#2B2B2B" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Background" Value="{StaticResource YellowBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DecimalRadio" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="B" MinWidth="30" Height="24" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1" Margin="0,0,-1,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#2B2B2B" />
                            <Setter Property="Foreground" Value="{StaticResource YellowBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="#555555" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="#555555" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="0,0,14,0" Background="Transparent">
                        <ContentPresenter x:Name="C" ContentSource="Header" Margin="0,4,0,7" />
                        <Border x:Name="Bar" Height="3" VerticalAlignment="Bottom" Background="{StaticResource YellowBrush}" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#1E1E1E" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#1E1E1E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelTabControl" TargetType="TabControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="#D3D3CE" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Background="Transparent" KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent" Margin="0,10,0,0" KeyboardNavigation.TabNavigation="Local" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SensorListItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="B" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="2,0,0,0" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#E2E2DC" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#2B2B2B" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource YellowBrush}" />
                            <Setter Property="Foreground" Value="#F2F2EE" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="B" Property="BorderBrush" Value="#555555" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#F2F2EF" />
        <Setter Property="BorderBrush" Value="#BCBCB8" />
        <Setter Property="Foreground" Value="#2A2A2A" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

</ResourceDictionary>
