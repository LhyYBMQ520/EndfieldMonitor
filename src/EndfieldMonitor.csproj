<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <AssemblyName>EndfieldMonitor</AssemblyName>
    <RootNamespace>EndfieldMonitor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>EndfieldMonitor</Product>
    <Description>协议核心风格透明桌面硬件监控挂件</Description>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);SYSLIB1054;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF 项目的隐式 using 不含 System.IO。托盘直接使用 Shell_NotifyIcon，无需引入 WinForms。 -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
    <EmbeddedResource Include="Resources\app.ico" LogicalName="EndfieldMonitor.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EndfieldMonitor.Tests" />
  </ItemGroup>

</Project>
