<UserControl x:Class="EndfieldMonitor.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EndfieldMonitor.ViewModels"
             FontFamily="{StaticResource UiFont}" FontSize="12.5" Foreground="#2E2E2E"
             Width="372"
             KeyboardNavigation.TabNavigation="Cycle"
             KeyboardNavigation.ControlTabNavigation="Cycle"
             AutomationProperties.Name="监控设置">
    <UserControl.Resources>
        <!-- 单个槽位的配置模板（上下槽位共用） -->
        <DataTemplate x:Key="SlotTemplate" DataType="{x:Type vm:SlotSettingsViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="11.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#55554F" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectionMissing}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid Margin="0,0,0,6">
                    <TextBox x:Name="SearchBox" Style="{StaticResource PanelTextBox}"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                             AutomationProperties.Name="搜索传感器（设备名、传感器名或类型）" />
                    <TextBlock Text="搜索：设备 / 传感器 / 类型，如 GPU 温度" Foreground="#9A9A94" Margin="8,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ListBox ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         Height="196" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource FieldBorderBrush}"
                         ItemContainerStyle="{StaticResource SensorListItem}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="传感器列表">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="#E3E3DD" Padding="6,3">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#3A3A36" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SensorItem}">
                            <Grid ToolTip="{Binding Label}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding KindText}" Opacity=".6" Margin="6,0" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontFamily="{StaticResource DigitFont}"
                                           TextAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="显示名称" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Grid Grid.Column="1">
                        <TextBox x:Name="NameBox" Style="{StaticResource PanelTextBox}" MaxLength="32"
                                 Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                 AutomationProperties.Name="自定义显示名称，留空使用默认名称" />
                        <TextBlock Text="{Binding NamePlaceholder}" Foreground="#9A9A94" Margin="8,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NameBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="小数位" VerticalAlignment="Center" Margin="0,8,10,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0"
                                AutomationProperties.Name="小数位">
                        <RadioButton Content="0" Style="{StaticResource DecimalRadio}" GroupName="{Binding Header}"
                                     IsChecked="{Binding Decimals, Converter={x:Static vm:IntEqualsConverter.Instance}, ConverterParameter=0}" />
                        <RadioButton Content="1" Style="{StaticResource DecimalRadio}" GroupName="{Binding Header}"
                                     IsChecked="{Binding Decimals, Converter={x:Static vm:IntEqualsConverter.Instance}, ConverterParameter=1}" />
                        <RadioButton Content="2" Style="{StaticResource DecimalRadio}" GroupName="{Binding Header}"
                                     IsChecked="{Binding Decimals, Converter={x:Static vm:IntEqualsConverter.Instance}, ConverterParameter=2}" />
                        <TextBlock Text="单位由传感器决定" Foreground="#8A8A84" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource PaperBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity=".18" Color="Black" />
        </Border.Effect>
        <Grid>
            <!-- 左上角黄色短条（参考页 .settings::before） -->
            <Border Width="82" Height="3" Background="{StaticResource YellowBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-1,-1,0,0" />
            <DockPanel Margin="16,12,16,14">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="监控设置" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="ENDFIELD · MONITOR" FontFamily="{StaticResource DigitFont}" FontSize="9" Foreground="#9A9A94"
                               VerticalAlignment="Center" Margin="70,2,0,0" />
                    <Button x:Name="CloseButton" Content="×" Style="{StaticResource PanelIconButton}" HorizontalAlignment="Right"
                            AutomationProperties.Name="关闭监控设置" Click="CloseButton_Click" />
                </Grid>

                <Button DockPanel.Dock="Bottom" Content="恢复默认监控配置" Style="{StaticResource PanelButton}"
                        Margin="0,10,0,0" Command="{Binding ResetSlotsCommand}"
                        AutomationProperties.Name="恢复默认监控配置（上下两个监控项）" />

                <TabControl x:Name="Tabs" Style="{StaticResource PanelTabControl}">
                    <TabItem Header="上方监控" Style="{StaticResource PanelTab}">
                        <ContentControl Content="{Binding Top}" ContentTemplate="{StaticResource SlotTemplate}" Focusable="False" />
                    </TabItem>
                    <TabItem Header="下方监控" Style="{StaticResource PanelTab}">
                        <ContentControl Content="{Binding Bottom}" ContentTemplate="{StaticResource SlotTemplate}" Focusable="False" />
                    </TabItem>
                    <TabItem Header="显示" Style="{StaticResource PanelTab}">
                        <StackPanel>
                            <Grid Margin="0,2,0,10">
                                <TextBlock Text="挂件缩放" VerticalAlignment="Center" />
                                <ComboBox HorizontalAlignment="Right" Width="96" ItemsSource="{Binding ScaleOptions}"
                                          SelectedItem="{Binding SelectedScale}" AutomationProperties.Name="挂件缩放" />
                            </Grid>
                            <CheckBox Style="{StaticResource PanelCheckBox}" IsChecked="{Binding ParticlesEnabled}" Margin="0,0,0,10"
                                      AutomationProperties.Name="粒子动画">
                                <StackPanel>
                                    <TextBlock Text="粒子动画" />
                                    <TextBlock Text="关闭后保留静态粒子图形" Foreground="#8A8A84" FontSize="11" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="置顶、锁定（鼠标穿透）与恢复默认位置请使用托盘图标菜单。" TextWrapping="Wrap"
                                       Foreground="#74746F" FontSize="11.5" Margin="0,6,0,0" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="状态" Style="{StaticResource PanelTab}">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="Margin" Value="0,0,0,2" />
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="采集状态" Foreground="#8A8A84" FontSize="11" />
                            <TextBlock Text="{Binding CollectorText}" Margin="0,0,0,8" />
                            <TextBlock Text="最近更新" Foreground="#8A8A84" FontSize="11" />
                            <TextBlock Text="{Binding LastUpdateText}" FontFamily="{StaticResource DigitFont}" Margin="0,0,0,8" />
                            <TextBlock Text="权限" Foreground="#8A8A84" FontSize="11" />
                            <TextBlock Text="{Binding PrivilegeText}" Margin="0,0,0,4" />
                            <Button Content="以管理员身份重新启动" Style="{StaticResource PanelButton}" HorizontalAlignment="Left"
                                    Command="{Binding RestartAsAdminCommand}" Margin="0,2,0,8"
                                    Visibility="{Binding IsAdmin, Converter={x:Static vm:InverseBoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="渲染" Foreground="#8A8A84" FontSize="11" />
                            <TextBlock Text="{Binding PerformanceText}" Margin="0,0,0,8" />
                            <TextBlock Text="配置文件" Foreground="#8A8A84" FontSize="11" />
                            <TextBox Text="{Binding ConfigPath, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     TextWrapping="Wrap" FontSize="11" Foreground="#55554F" Margin="0,0,0,8" />
                            <TextBlock Text="错误摘要" Foreground="#8A8A84" FontSize="11"
                                       Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource WarningBrush}" FontSize="11.5"
                                       Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
